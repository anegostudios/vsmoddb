<li class="file template">
	<input type="hidden" name="fileIds[]" />
	<input class="trigger" type="checkbox" name="attachedFileIds[]" />
	<div>
		<a href="#">
			<div class="fi">
				<div class="fi-content"></div>
			</div>
			<img src="" style="display:none;" />
			<div class="details">
				<h5 class="filename"></h5>
				<small class="uploaddate"></small>
				<small>
					<span class="imagesize"></span>
					<span class="size"></span>
				</small>
			</div>
		</a>
		<div class="buttons" style="display: none;">
			<label class="button" title="Detach"><i class="bx"></i></label>
			<button type="button" class="delete" title="Delete"><i class="bx bx-trash"></i></button>
		</div>
	</div>
	<div class="uploadprogress">0%</div>
</li>
